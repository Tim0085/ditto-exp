# 本机配置：复制成 local.env 再填。local.env 不进 git（.gitignore）。scripts/real.sh、scripts/sync-repo.sh 开头会读它。
# DeepSeek 密钥开头的几位（sk- 后面再加几位）：出口据此在密钥文件里认出要用的那个密钥。
DEEPSEEK_KEY_PREFIX=sk-xxx
# 可能放着 DeepSeek 密钥的文件，空格分开，按顺序找第一个含上面前缀开头的密钥的（路径里不能有空格）。
# 也可以运行时用 DEEPSEEK_KEY_FILE=<路径> bash scripts/real.sh run ... 直接指定。
DEEPSEEK_KEY_CANDIDATES="/path/to/deepseek.env"
# GPT-4o 判分的配置文件（JSON：baseUrl、apiKey、model），见 src/judge.py
JUDGE_KEY_FILE=/path/to/gpt4o-judge.json
# 公开代码仓库 ditto-exp 的本地路径（scripts/sync-repo.sh 同步代码、src/run_info.py 记提交号用）
DITTO_EXP_REPO=/path/to/ditto-exp
